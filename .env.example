# Optional City of Edmonton Socrata app token. Leave blank for anonymous reads.
SOCRATA_APP_TOKEN=
# Every environment variable OpenPath reads. Never commit real values.
# Nothing loads this file or a .env file:
# Render and Vercel take their values from their dashboards (docs/DEPLOY.md),
# `make dev` and `make web` set their own local values and need no keys (scripts/dev.py),
# and for anything else you run by hand, set the variables in your shell first.

# ===== cloud (Render) =====

# Render sets this from the openpath-db database
DATABASE_URL=sqlite:///./openpath.db
# Header X-Admin-Key for /api/admin/override (testing only)
ADMIN_KEY=
# Header X-Worker-Key for /api/ingest/camera
WORKER_KEY=
# Comma-separated origins. `*` matches part of one host-name label: https://openpath-*-<team-slug>.vercel.app
# Not a security boundary (public data, no cookies; writes need the keys above)
CORS_ORIGINS=http://localhost:3000
# City of Edmonton open data app token
# Web Push public key (OP-304)
VAPID_PUBLIC_KEY=
# Web Push private key (OP-304)
VAPID_PRIVATE_KEY=
# Web Push contact, a mailto: address
VAPID_SUBJECT=
# live or replay (reported by GET /health as "mode")
DATA_MODE=live
# Folder (not a file) of recorded responses, one subfolder per source, used when DATA_MODE=replay
REPLAY_SNAPSHOT=
# Optional ISO time (with zone) that freezes the clock in replay mode, so dated records stay in force
REPLAY_AT=
# on (default) runs every data source on its cadence; off serves only what the database holds
SCHEDULER=on
# Weather observation point (OP-109)
WEATHER_LAT=
# Weather observation point (OP-109)
WEATHER_LNG=
# Feature flag for walk and LRT trips (OP-311)
LRT_TRIPS=false

# ===== vision worker (a team laptop during the demo; WORKER_KEY is shared with cloud) =====

# Where the worker posts readings
CLOUD_URL=http://localhost:8000
# 511 Alberta developer key (OP-112)
ALBERTA_511_KEY=
# URL of the ONNX weights release asset (OP-202)
MODEL_URL=
# Claude agree check (worker --ai-check only; lead decision, November 8)
ANTHROPIC_API_KEY=

# ===== web (Vercel) =====

# API base URL, with no trailing slash
NEXT_PUBLIC_API_URL=http://localhost:8000
# WebSocket URL
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
# Web Push public key, the same value as VAPID_PUBLIC_KEY
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
