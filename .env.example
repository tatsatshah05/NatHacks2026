# Optional City of Edmonton Socrata app token. Leave blank for anonymous reads.
SOCRATA_APP_TOKEN=
# Every environment variable OpenPath reads. Never commit real values.
# Nothing loads this file or a .env file:
# Render and Vercel take their values from their dashboards (docs/DEPLOY.md),
# `make dev` and `make web` set their own local values and need no keys (scripts/dev.py),
# and for anything else you run by hand, set the variables in your shell first.

# ===== cloud (Render) =====

# Render sets this from the openpath-db database
DATABASE_URL=sqlite:///./openpath.db
# Header X-Admin-Key for /api/admin/override (testing only)
ADMIN_KEY=
# Header X-Worker-Key for /api/ingest/camera
WORKER_KEY=
# Comma-separated origins. `*` matches part of one host-name label: https://openpath-*-<team-slug>.vercel.app
# Not a security boundary (public data, no cookies; writes need the keys above)
CORS_ORIGINS=http://localhost:3000
# City of Edmonton open data app token
# Web Push public key (OP-304); generate the pair with python -m cloud.app.push --generate-keys
VAPID_PUBLIC_KEY=
# Web Push private key (OP-304); never commit it
VAPID_PRIVATE_KEY=
# Web Push contact, a mailto: address
VAPID_SUBJECT=
# live or replay (reported by GET /health as "mode")
DATA_MODE=live
# Folder (not a file) of recorded responses, one subfolder per source, used when DATA_MODE=replay
REPLAY_SNAPSHOT=
# Optional ISO time (with zone) that freezes the clock in replay mode, so dated records stay in force
REPLAY_AT=
# Replay clock (OP-305): frozen or running. running starts at REPLAY_AT (or the snapshot
# manifest's replay_at) and advances in real time, so freshness ages and items expire
REPLAY_CLOCK=
# Named weather recording under <REPLAY_SNAPSHOT>/weather/, e.g. freeze_thaw (OP-305)
WEATHER_REPLAY=
# on (default) runs every data source on its cadence; off serves only what the database holds
SCHEDULER=on
# Weather observation point (OP-109)
WEATHER_LAT=
# Weather observation point (OP-109)
WEATHER_LNG=
# Feature flag for walk and LRT trips (OP-311)
LRT_TRIPS=false
# API log lines (OP-402): text (default, one line per record) or json (one JSON object per line)
LOG_FORMAT=
# Level of the API's own loggers (default INFO, which includes every CHANGE line); WARNING logs only problems
LOG_LEVEL=
# Community report photo check (OP-308; lead decision, November 8): the ONNX model and Claude check
# each photo together, and medium confidence needs both to agree (docs/DEPLOY.md, section 6).
# The model: a local file (MODEL_FILE) or an HTTPS release asset (MODEL_URL, in the vision section),
# its labels.json (a local path or an HTTPS URL; its sha256 must equal MODEL_SHA256) and its SHA-256.
# Claude: ANTHROPIC_API_KEY (below). With only one of the two, photos are checked by that one alone
# and a warning is logged; with neither, photos are not checked
MODEL_FILE=
MODEL_LABELS=
MODEL_SHA256=
# Lowest model score that counts as a class (default 0.5; an assumption, not a measured value)
MODEL_MIN_SCORE=
# Claude model for the report photo check (default claude-haiku-5-5)
REPORTS_AI_MODEL=

# ===== vision worker (a team laptop during the demo; WORKER_KEY is shared with cloud) =====

# Where the worker posts readings
CLOUD_URL=http://localhost:8000
# 511 Alberta developer key (OP-112)
ALBERTA_511_KEY=
# URL of the ONNX weights release asset (OP-202); also read by the API for report photos (OP-308)
MODEL_URL=
# Claude agree check (worker --ai-check; lead decision, November 8). On the API (Render) it is the
# Claude half of the report photo check (OP-308); report photos are sent to the Anthropic API, never stored
ANTHROPIC_API_KEY=

# ===== web (Vercel) =====

# API base URL, with no trailing slash
NEXT_PUBLIC_API_URL=http://localhost:8000
# WebSocket URL
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
# Web Push public key, the same value as VAPID_PUBLIC_KEY
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
