# Copy to .env for local overrides. Never commit real values.
# `make dev` needs none of these: it uses SQLite and recorded fixtures.

# --- cloud (Render) ---
DATABASE_URL=sqlite:///./openpath.db   # Render sets this from the openpath-db database
ADMIN_KEY=                              # header X-Admin-Key for /api/admin/override (testing only)
WORKER_KEY=                             # header X-Worker-Key for /api/ingest/camera
CORS_ORIGINS=http://localhost:3000      # comma-separated; `*` allowed in a label, e.g. https://openpath-*.vercel.app
SOCRATA_APP_TOKEN=                      # City of Edmonton open data app token
VAPID_PUBLIC_KEY=                       # Web Push keys (OP-304)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                          # mailto: address for Web Push
DATA_MODE=live                          # live or replay
REPLAY_SNAPSHOT=                        # path to a recorded snapshot when DATA_MODE=replay
WEATHER_LAT=                            # weather observation point (OP-109)
WEATHER_LNG=
LRT_TRIPS=false                         # feature flag for walk and LRT trips (OP-311)

# --- vision worker (Render background worker) ---
CLOUD_URL=http://localhost:8000
ALBERTA_511_KEY=                        # 511 Alberta developer key (OP-112)
MODEL_URL=                              # URL of the ONNX weights release asset (OP-202)
# WORKER_KEY is shared with cloud (above)

# --- web (Vercel) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
