# Copy to .env for local overrides. Never commit real values.
# `make dev` needs none of these: it uses SQLite and recorded fixtures.

# ===== cloud (Render) =====

# Render sets this from the openpath-db database
DATABASE_URL=sqlite:///./openpath.db
# Header X-Admin-Key for /api/admin/override (testing only)
ADMIN_KEY=
# Header X-Worker-Key for /api/ingest/camera
WORKER_KEY=
# Comma-separated origins; `*` matches one host-name part, e.g. https://openpath-*.vercel.app
CORS_ORIGINS=http://localhost:3000
# City of Edmonton open data app token
SOCRATA_APP_TOKEN=
# Web Push public key (OP-304)
VAPID_PUBLIC_KEY=
# Web Push private key (OP-304)
VAPID_PRIVATE_KEY=
# Web Push contact, a mailto: address
VAPID_SUBJECT=
# live or replay
DATA_MODE=live
# Path to a recorded snapshot when DATA_MODE=replay
REPLAY_SNAPSHOT=
# Weather observation point (OP-109)
WEATHER_LAT=
# Weather observation point (OP-109)
WEATHER_LNG=
# Feature flag for walk and LRT trips (OP-311)
LRT_TRIPS=false

# ===== vision worker (Render background worker; WORKER_KEY is shared with cloud) =====

# Where the worker posts readings
CLOUD_URL=http://localhost:8000
# 511 Alberta developer key (OP-112)
ALBERTA_511_KEY=
# URL of the ONNX weights release asset (OP-202)
MODEL_URL=

# ===== web (Vercel) =====

# API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
# WebSocket URL
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
# Web Push public key, the same value as VAPID_PUBLIC_KEY
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
